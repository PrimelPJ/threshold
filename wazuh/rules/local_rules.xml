<!--
  local_rules.xml
  Custom detection rules for brute force and password spraying against the
  lab domain controller. These sit on top of Wazuh's built-in Windows
  ruleset (which already parses event channel 4625 = failed logon and
  4740 = account locked out).

  Rule id ranges 100000+ are reserved for local rules.

  Logon failure sub-status codes worth knowing:
    0xC000006A  bad password
    0xC0000064  user does not exist
    0xC0000234  account locked out
    0xC0000072  account disabled
-->
<group name="local,windows,authentication,bruteforce,">

  <!-- Base: a single failed logon on a Windows host (4625).
       Wazuh rule 60204 already matches Windows security events; we scope
       to the failed-logon event id so our frequency rules have a clean parent. -->
  <rule id="100100" level="3">
    <if_sid>60204</if_sid>
    <field name="win.system.eventID">^4625$</field>
    <description>Windows: failed logon for user $(win.eventdata.targetUserName) from $(win.eventdata.ipAddress)</description>
    <options>no_full_log</options>
    <group>authentication_failed,</group>
  </rule>

  <!-- Brute force: many failures against ONE account in a short window.
       frequency = how many matches, timeframe = seconds, same_field groups
       them by the targeted username. -->
  <rule id="100110" level="10" frequency="8" timeframe="120">
    <if_matched_sid>100100</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>Brute force: 8+ failed logons for $(win.eventdata.targetUserName) within 2 minutes</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,bruteforce,</group>
  </rule>

  <!-- Password spray: many failures from ONE source IP across the window,
       which usually means the same password tried against many accounts.
       Grouped by source IP instead of username. -->
  <rule id="100120" level="12" frequency="10" timeframe="120">
    <if_matched_sid>100100</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>Password spray: 10+ failed logons from $(win.eventdata.ipAddress) within 2 minutes</description>
    <mitre>
      <id>T1110.003</id>
    </mitre>
    <group>authentication_failures,password_spray,</group>
  </rule>

  <!-- Account lockout (4740): the lockout policy fired. High signal. -->
  <rule id="100130" level="10">
    <if_sid>60204</if_sid>
    <field name="win.system.eventID">^4740$</field>
    <description>Account $(win.eventdata.targetUserName) locked out (brute force lockout policy triggered)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>account_lockout,bruteforce,</group>
  </rule>

  <!-- Escalation: a source IP that triggers the spray rule repeatedly.
       This is the one wired to active response so repeat offenders get blocked. -->
  <rule id="100140" level="13" frequency="2" timeframe="300">
    <if_matched_sid>100120</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>Sustained password spray from $(win.eventdata.ipAddress): blocking source</description>
    <mitre>
      <id>T1110.003</id>
    </mitre>
    <group>password_spray,active_response,</group>
  </rule>

  <!-- Credential stuffing: same account targeted from many distinct IPs.
       Attackers rotate source addresses to stay below per-IP thresholds;
       grouping by username across a longer window surfaces this pattern. -->
  <rule id="100150" level="11" frequency="6" timeframe="600">
    <if_matched_sid>100100</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <different_field>win.eventdata.ipAddress</different_field>
    <description>Credential stuffing: 6+ failed logons for $(win.eventdata.targetUserName) from distinct source IPs</description>
    <mitre>
      <id>T1110.004</id>
    </mitre>
    <group>authentication_failures,credential_stuffing,</group>
  </rule>

  <!-- Kerberoasting: service ticket (4769) requested with RC4-HMAC (0x17)
       encryption. Modern domains negotiate AES; a downgrade to RC4 is the
       canonical indicator that an attacker is requesting a crackable ticket. -->
  <rule id="100160" level="12">
    <if_sid>60204</if_sid>
    <field name="win.system.eventID">^4769$</field>
    <field name="win.eventdata.ticketEncryptionType">^0x17$</field>
    <description>Kerberoasting: RC4-encrypted service ticket for $(win.eventdata.serviceName) requested by $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1558.003</id>
    </mitre>
    <group>kerberoasting,lateral_movement,</group>
  </rule>

  <!-- AS-REP roasting: TGT request (4768) with RC4-HMAC (0x17) encryption.
       Accounts with pre-authentication disabled issue a crackable ticket
       without requiring the requester to prove knowledge of the password. -->
  <rule id="100170" level="12">
    <if_sid>60204</if_sid>
    <field name="win.system.eventID">^4768$</field>
    <field name="win.eventdata.ticketEncryptionType">^0x17$</field>
    <description>AS-REP roasting: RC4-encrypted TGT issued for $(win.eventdata.targetUserName) without pre-authentication</description>
    <mitre>
      <id>T1558.004</id>
    </mitre>
    <group>asreproasting,lateral_movement,</group>
  </rule>

  <!-- Pass-the-Hash: a successful NTLM network logon (4624, LogonType 3)
       indicates lateral movement when NTLM is used instead of Kerberos.
       Legitimate domain workstation access normally negotiates Kerberos;
       NTLM network logons are typical of PtH tools like Mimikatz/pth-winexe. -->
  <rule id="100180" level="11">
    <if_sid>60204</if_sid>
    <field name="win.system.eventID">^4624$</field>
    <field name="win.eventdata.logonType">^3$</field>
    <field name="win.eventdata.authenticationPackageName">^NTLM$</field>
    <description>Pass-the-Hash: NTLM network logon for $(win.eventdata.targetUserName) from $(win.eventdata.ipAddress)</description>
    <mitre>
      <id>T1550.002</id>
    </mitre>
    <group>lateral_movement,pass_the_hash,</group>
  </rule>

  <!-- DCSync: directory replication rights exercised outside a domain controller.
       Event 4662 fires when a directory object operation is performed; the GUID
       1131f6ad-9c07-11d1-f79f-00c04fc2dcd2 (DS-Replication-Get-Changes-All) in
       the properties field means the caller pulled all password attribute changes.
       Legitimate callers are domain controllers; a workstation or Kali host doing
       this is Mimikatz or Impacket secretsdump. Level 14 = critical. -->
  <rule id="100190" level="14">
    <if_sid>60204</if_sid>
    <field name="win.system.eventID">^4662$</field>
    <field name="win.eventdata.properties">1131f6ad-9c07-11d1-f79f-00c04fc2dcd2</field>
    <description>DCSync: DS-Replication-Get-Changes-All exercised by $(win.eventdata.subjectUserName) — potential credential harvesting</description>
    <mitre>
      <id>T1003.006</id>
    </mitre>
    <group>credential_access,dcsync,</group>
  </rule>

</group>
